{
	"name": "fdf",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.makefile-tools"
			]
		}
	},
	"postCreateCommand": "make",
	"postStartCommand": "start-vnc.sh",
	"forwardPorts": [6080],
	"portsAttributes": {
		"6080": {
			"label": "noVNC",
			"onAutoForward": "openPreview"
		}
	}
}
